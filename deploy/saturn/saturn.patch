--- /dev/null
+++ b/social/functions/projects/[[path]].js
@@ -0,0 +1,24 @@
+// /projects/ is showcase, the code site at code.danieldaum.net, not files in
+// this repo (the old pages under projects/ are never served).
+//
+// MODE "redirect": send visitors to code.danieldaum.net.
+// MODE "proxy": serve showcase here at /projects/. Run showcase with
+//   "base_path": "/projects" first, so its links stay under /projects/.
+//   Clone, go get and docker pull stay on code.danieldaum.net.
+const ORIGIN = "https://code.danieldaum.net";
+const MODE = "redirect";
+
+export async function onRequest({ request }) {
+    const url = new URL(request.url);
+    if (MODE === "redirect") {
+        const rest = url.pathname.replace(/^\/projects/, "") || "/";
+        return Response.redirect(ORIGIN + rest + url.search, 302);
+    }
+    if (request.method !== "GET" && request.method !== "HEAD") {
+        return new Response("not found", { status: 404 });
+    }
+    // the origin is fixed: only showcase's own pages can come back
+    const upstream = new Request(ORIGIN + url.pathname + url.search, request);
+    upstream.headers.delete("Cookie");
+    return fetch(upstream, { redirect: "manual" });
+}
